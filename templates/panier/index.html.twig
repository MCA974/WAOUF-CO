{% extends 'base.html.twig' %}

{% block title %}Mon Panier - WAOUF & CO !{% endblock %}

{% block body %}
    <div class="max-w-4xl mx-auto space-y-8">
        
        <!-- Header -->
        <div class="flex items-center justify-between border-b-[3px] border-ink pb-4">
            <div>
                <h1 class="font-fredoka text-3xl sm:text-4xl font-bold text-ink">
                    Votre Panier Pop 🛍️
                </h1>
                <p class="text-sm font-semibold text-gray-600">
                    {{ totaux.nombreArticles }} article{% if totaux.nombreArticles > 1 %}s{% endif %} sélectionné{% if totaux.nombreArticles > 1 %}s{% endif %}
                </p>
            </div>

            <a href="{{ path('app_catalogue') }}" class="brutal-btn brutal-btn-white text-xs sm:text-sm py-2 px-3">
                ← Continuer les achats
            </a>
        </div>

        {% if elements|length == 0 %}
            <div class="brutal-card bg-card p-12 text-center space-y-4">
                <div class="text-6xl animate-bounce">🛒</div>
                <h3 class="font-fredoka text-2xl font-bold">Votre panier est tout vide !</h3>
                <p class="text-sm font-semibold text-gray-600 max-w-sm mx-auto">
                    Nos animaux en quête d'un foyer et nos accessoires colorés ont hâte de vous rencontrer.
                </p>
                <a href="{{ path('app_catalogue') }}" class="brutal-btn brutal-btn-yellow inline-block text-sm py-3 px-6">
                    Explorer le catalogue ➔
                </a>
            </div>
        {% else %}
            <!-- Free Shipping Bar -->
            <div class="brutal-card bg-white p-4 border-[3px] border-ink">
                {% if totaux.fraisPortOfferts %}
                    <div class="flex items-center gap-2 text-sm font-bold text-ink font-fredoka">
                        <span class="text-xl">🎉</span>
                        <span>FÉLICITATIONS ! Les frais de port (4,90 €) vous sont OFFERTS !</span>
                    </div>
                {% else %}
                    <div class="flex items-center justify-between text-xs sm:text-sm font-bold font-fredoka mb-2">
                        <span>🚚 Plus que <strong>{{ totaux.restePourPortOffert|prix_euro }}</strong> pour débloquer la livraison gratuite !</span>
                        <span>Seuil : 50,00 €</span>
                    </div>
                    {% set pct = min(100, ((totaux.sousTotalTTC / 5000) * 100)|round) %}
                    <div class="w-full bg-gray-200 h-4 border-2 border-ink rounded-full overflow-hidden">
                        <div class="bg-loisirs h-full transition-all duration-300" style="width: {{ pct }}%;"></div>
                    </div>
                {% endif %}
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
                
                <!-- Items list -->
                <div class="lg:col-span-7 space-y-4">
                    {% for item in elements %}
                        <div class="brutal-card bg-card p-4 sm:p-5 flex flex-col sm:flex-row gap-4 items-start sm:items-center justify-between">
                            
                            <div class="flex gap-4 items-center">
                                <div class="w-20 h-20 rounded-lg border-2 border-ink overflow-hidden flex-shrink-0 bg-gray-100">
                                    <img src="{{ item.article.image }}" alt="{{ item.article.nom }}" class="w-full h-full object-cover">
                                </div>

                                <div>
                                    <h3 class="font-fredoka font-bold text-base sm:text-lg text-ink">
                                        {{ item.article.nom }}
                                    </h3>
                                    
                                    {% if item.option %}
                                        <span class="inline-block text-xs font-bold bg-gray-100 border border-ink px-2 py-0.5 rounded text-gray-700 mt-1">
                                            Option : {{ item.option }}
                                        </span>
                                    {% endif %}

                                    {% if item.isAnimal %}
                                        <div class="mt-1">
                                            <span class="inline-block text-xs font-bold bg-animaux text-white border border-ink px-2 py-0.5 rounded">
                                                🐾 Dossier d'Adoption (1 max)
                                            </span>
                                        </div>
                                    {% endif %}

                                    <div class="text-xs text-gray-500 font-semibold mt-1">
                                        Prix unitaire : {{ item.prixUnitaire|prix_euro }}
                                    </div>
                                </div>
                            </div>

                            <!-- Quantity and Subtotal -->
                            <div class="flex sm:flex-col items-center sm:items-end justify-between w-full sm:w-auto gap-3">
                                <span class="price-tag text-xl font-bold text-ink">
                                    {{ item.totalLigne|prix_euro }}
                                </span>

                                <div class="flex items-center gap-2">
                                    {% if item.isAnimal %}
                                        <span class="text-xs font-bold font-fredoka bg-gray-100 border-2 border-ink px-2 py-1 rounded">
                                            Qté : 1
                                        </span>
                                    {% else %}
                                        <div class="inline-flex items-center border-2 border-ink rounded-lg bg-gray-50 overflow-hidden">
                                            <a href="{{ path('app_panier_diminuer', {'cle': item.cle}) }}" class="px-2.5 py-1 font-bold hover:bg-gray-200 text-sm">
                                                -
                                            </a>
                                            <span class="px-3 py-1 text-xs font-bold font-fredoka bg-white">
                                                {{ item.quantite }}
                                            </span>
                                            <a href="{{ path('app_panier_ajouter', {'id': item.article.id, 'option': item.option}) }}" class="px-2.5 py-1 font-bold hover:bg-gray-200 text-sm">
                                                +
                                            </a>
                                        </div>
                                    {% endif %}

                                    <a href="{{ path('app_panier_supprimer', {'cle': item.cle}) }}" class="text-gray-400 hover:text-animaux font-bold p-1 text-base" title="Supprimer">
                                        🗑️
                                    </a>
                                </div>
                            </div>

                        </div>
                    {% endfor %}
                </div>

                <!-- Summary Sidebar -->
                <div class="lg:col-span-5 space-y-4">
                    
                    <!-- Promo code box -->
                    <div class="brutal-card bg-card p-4 border-[3px] border-ink">
                        <h4 class="font-fredoka font-bold text-sm uppercase text-gray-700 mb-2">Code Promotionnel</h4>
                        <form action="{{ path('app_panier_promo') }}" method="POST" class="flex gap-2">
                            <input 
                                type="text" 
                                name="code_promo" 
                                value="{{ totaux.codePromo }}"
                                placeholder="Code (ex: WAOUF10)" 
                                class="brutal-input text-xs py-2 px-3 flex-1 uppercase"
                                {% if totaux.codePromo %}disabled{% endif %}
                            >
                            {% if totaux.codePromo %}
                                <a href="{{ path('app_panier_promo_retirer') }}" class="brutal-btn brutal-btn-white text-xs py-2 px-3">
                                    Retirer
                                </a>
                            {% else %}
                                <button type="submit" class="brutal-btn brutal-btn-yellow text-xs py-2 px-4">
                                    Appliquer
                                </button>
                            {% endif %}
                        </form>
                        {% if totaux.codePromo %}
                            <p class="text-xs font-bold text-green-700 mt-2 font-fredoka flex items-center gap-1">
                                <span>🎉</span> Code WAOUF10 appliqué : -10% de remise immédiate !
                            </p>
                        {% endif %}
                    </div>

                    <!-- Totals breakdown -->
                    <div class="brutal-card bg-card p-6 border-[3px] border-ink space-y-3 font-semibold text-sm">
                        <h3 class="font-fredoka text-xl font-bold border-b-2 border-ink pb-2">
                            Récapitulatif
                        </h3>

                        <div class="flex justify-between text-gray-600">
                            <span>Sous-total HT</span>
                            <span>{{ totaux.sousTotalHT|prix_euro }}</span>
                        </div>

                        <div class="flex justify-between text-gray-600">
                            <span>TVA (20%)</span>
                            <span>{{ totaux.tva|prix_euro }}</span>
                        </div>

                        <div class="flex justify-between text-gray-800 font-bold">
                            <span>Sous-total TTC</span>
                            <span>{{ totaux.sousTotalTTC|prix_euro }}</span>
                        </div>

                        {% if totaux.montantRemise > 0 %}
                            <div class="flex justify-between text-animaux font-bold">
                                <span>Remise Code Promo</span>
                                <span>-{{ totaux.montantRemise|prix_euro }}</span>
                            </div>
                        {% endif %}

                        <div class="flex justify-between items-center text-gray-800">
                            <span>Frais de livraison</span>
                            <span>
                                {% if totaux.fraisPort == 0 %}
                                    <span class="text-green-700 font-bold bg-green-100 border border-green-500 px-2 py-0.5 rounded text-xs">OFFERT</span>
                                {% else %}
                                    {{ totaux.fraisPort|prix_euro }}
                                {% endif %}
                            </span>
                        </div>

                        <div class="border-t-[3px] border-ink pt-3 flex justify-between items-baseline font-fredoka text-ink">
                            <span class="text-lg font-bold">TOTAL À REGLER</span>
                            <span class="text-3xl font-extrabold text-animaux">{{ totaux.totalTTC|prix_euro }}</span>
                        </div>

                        <div class="pt-4">
                            <a href="{{ path('app_commande_valider') }}" class="brutal-btn brutal-btn-primary w-full py-4 text-center text-lg block shadow-brutal-hover">
                                Valider ma commande ➔
                            </a>
                        </div>
                    </div>

                </div>

            </div>
        {% endif %}

    </div>
{% endblock %}
