<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}WAOUF & CO ! - L'animalerie Pop & Heureuse{% endblock %}</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Tailwind CSS (CDN) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        bg: '#FFF9E6',
                        ink: '#121212',
                        card: '#FFFFFF',
                        animaux: '#FF6B6B',
                        alimentation: '#4ECDC4',
                        loisirs: '#FFE66D',
                        fashion: '#A29BFE',
                        sticker: '#FF9F43',
                    },
                    fontFamily: {
                        fredoka: ['Fredoka', 'sans-serif'],
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                    },
                    boxShadow: {
                        'brutal': '4px 4px 0px #121212',
                        'brutal-hover': '6px 6px 0px #121212',
                        'brutal-lg': '8px 8px 0px #121212',
                        'brutal-xl': '12px 12px 0px #121212',
                    }
                }
            }
        }
    </script>
    
    <!-- Custom Neo-Brutalist CSS -->
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    
    {% block stylesheets %}{% endblock %}
    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body class="bg-bg text-ink min-h-screen flex flex-col font-sans selection:bg-loisirs selection:text-ink">

    <!-- Top Announcement Bar -->
    <div class="bg-loisirs border-b-[3px] border-ink py-2 px-4 text-center font-fredoka font-bold text-sm tracking-wide flex items-center justify-center gap-2 overflow-hidden">
        <span class="inline-block animate-bounce">🦴</span>
        <span>CODE PROMO EXCLUSIF : <strong>WAOUF10</strong> pour -10% dès aujourd'hui ! • LIVRAISON OFFERTE DÈS 50 € !</span>
        <span class="inline-block animate-bounce">🐾</span>
    </div>

    <!-- Navigation Header -->
    <header class="sticky top-0 z-40 bg-card border-b-[3px] border-ink shadow-brutal">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3.5 flex items-center justify-between gap-4">
            
            <!-- Logo -->
            <a href="{{ path('app_catalogue') }}" class="flex items-center gap-3 group text-decoration-none">
                <div class="w-12 h-12 bg-animaux border-[3px] border-ink rounded-xl shadow-brutal flex items-center justify-center text-2xl group-hover:rotate-12 transition-transform duration-200">
                    🐶
                </div>
                <div>
                    <span class="font-fredoka text-2xl sm:text-3xl font-bold tracking-tight text-ink block leading-none">
                        WAOUF & CO <span class="text-animaux">!</span>
                    </span>
                    <span class="text-xs font-bold text-gray-600 uppercase tracking-wider block font-fredoka">
                        Animalerie & Adoptions
                    </span>
                </div>
            </a>

            <!-- Search Bar in Header -->
            <form action="{{ path('app_catalogue') }}" method="GET" class="hidden md:flex flex-1 max-w-md mx-4">
                <div class="relative w-full">
                    <input 
                        type="text" 
                        name="q" 
                        value="{{ app.request.query.get('q') }}"
                        placeholder="Croquettes, harnais, Mimi le chat..." 
                        class="brutal-input text-sm py-2 pl-4 pr-10"
                    >
                    <button type="submit" class="absolute right-2.5 top-1/2 -translate-y-1/2 text-xl hover:scale-110 transition-transform">
                        🔍
                    </button>
                </div>
            </form>

            <!-- Actions (Account & Cart) -->
            <div class="flex items-center gap-3">
                {% if is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('app_admin_dashboard') }}" class="brutal-btn brutal-btn-yellow text-xs sm:text-sm py-2 px-3">
                        ⚡ Admin
                    </a>
                {% endif %}

                {% if app.user %}
                    <a href="{{ path('app_account') }}" class="brutal-btn brutal-btn-white text-xs sm:text-sm py-2 px-3 flex items-center gap-1.5" title="Mon Compte">
                        <span>👤</span>
                        <span class="hidden sm:inline">{{ app.user.prenom }}</span>
                    </a>
                    <a href="{{ path('app_logout') }}" class="text-xs font-bold hover:underline hidden lg:inline" title="Se déconnecter">
                        Déconnexion
                    </a>
                {% else %}
                    <a href="{{ path('app_login') }}" class="brutal-btn brutal-btn-white text-xs sm:text-sm py-2 px-3">
                        <span>🔑</span>
                        <span class="hidden sm:inline">Connexion</span>
                    </a>
                {% endif %}

                <!-- Cart Button (Drawer Trigger) -->
                <button 
                    id="open-cart-btn" 
                    type="button" 
                    class="brutal-btn brutal-btn-mint text-xs sm:text-sm py-2 px-3.5 relative flex items-center gap-2"
                >
                    <span class="text-lg">🛒</span>
                    <span class="hidden sm:inline">Panier</span>
                    <span 
                        id="cart-badge-count" 
                        class="bg-animaux text-white border-2 border-ink rounded-full px-2 py-0.5 text-xs font-bold leading-none shadow-[2px_2px_0px_#121212]"
                    >
                        {{ panier_count }}
                    </span>
                </button>
            </div>
        </div>
    </header>

    <!-- Flash Messages -->
    <div class="max-w-4xl mx-auto px-4 mt-6 w-full space-y-3">
        {% for message in app.flashes('success') %}
            <div class="brutal-card bg-alimentation border-[3px] border-ink p-4 flex items-center justify-between gap-3 font-fredoka font-bold text-ink">
                <div class="flex items-center gap-2">
                    <span class="text-2xl">🎉</span>
                    <span>{{ message }}</span>
                </div>
                <button onclick="this.parentElement.remove()" class="text-xl font-bold hover:scale-125 transition-transform">✕</button>
            </div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="brutal-card bg-animaux border-[3px] border-ink p-4 flex items-center justify-between gap-3 font-fredoka font-bold text-white">
                <div class="flex items-center gap-2">
                    <span class="text-2xl">⚠️</span>
                    <span>{{ message }}</span>
                </div>
                <button onclick="this.parentElement.remove()" class="text-xl font-bold hover:scale-125 transition-transform">✕</button>
            </div>
        {% endfor %}

        {% for message in app.flashes('info') %}
            <div class="brutal-card bg-loisirs border-[3px] border-ink p-4 flex items-center justify-between gap-3 font-fredoka font-bold text-ink">
                <div class="flex items-center gap-2">
                    <span class="text-2xl">ℹ️</span>
                    <span>{{ message }}</span>
                </div>
                <button onclick="this.parentElement.remove()" class="text-xl font-bold hover:scale-125 transition-transform">✕</button>
            </div>
        {% endfor %}
    </div>

    <!-- Main Content -->
    <main class="flex-1 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full">
        {% block body %}{% endblock %}
    </main>

    <!-- Cart Drawer (Tiroir Latéral) -->
    <div id="cart-drawer-overlay" class="brutal-drawer-overlay"></div>
    <div id="cart-drawer" class="brutal-drawer">
        <div class="p-5 border-b-[3px] border-ink bg-card flex items-center justify-between">
            <div class="flex items-center gap-2">
                <span class="text-2xl">🛍️</span>
                <h3 class="font-fredoka text-2xl font-bold">Votre Panier</h3>
            </div>
            <button id="close-cart-btn" class="brutal-btn brutal-btn-white py-1 px-3 text-lg font-bold">
                ✕
            </button>
        </div>
        
        <div id="cart-drawer-content" class="flex-1 overflow-y-auto p-5">
            <!-- Dynamically populated via AJAX or initial render -->
            <div class="text-center py-10 font-fredoka">
                <div class="text-5xl mb-3">🐾</div>
                <p class="text-lg">Chargement de votre panier...</p>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="bg-card border-t-[4px] border-ink mt-16 pt-12 pb-8">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
                
                <!-- Brand col -->
                <div class="space-y-4">
                    <div class="flex items-center gap-2">
                        <div class="w-10 h-10 bg-animaux border-[3px] border-ink rounded-lg shadow-brutal flex items-center justify-center text-xl">
                            🐶
                        </div>
                        <span class="font-fredoka text-2xl font-bold">WAOUF & CO !</span>
                    </div>
                    <p class="text-sm font-medium text-gray-700 leading-relaxed">
                        Le premier concept-store pour animaux 100% Pop Néo-Brutaliste ! Produits sains, jouets indestructibles et adoptions éthiques garanties.
                    </p>
                    <div class="flex gap-2">
                        <span class="brutal-sticker bg-loisirs rotate-left text-xs">#TEAMCHIEN</span>
                        <span class="brutal-sticker bg-fashion rotate-right text-xs">#TEAMCHAT</span>
                    </div>
                </div>

                <!-- Reassurance -->
                <div>
                    <h4 class="font-fredoka font-bold text-lg mb-4 text-ink flex items-center gap-2">
                        <span>✨</span> Nos Engagements
                    </h4>
                    <ul class="space-y-2.5 text-sm font-semibold">
                        <li class="flex items-center gap-2"><span>🚀</span> Expédition ultra-rapide 48h</li>
                        <li class="flex items-center gap-2"><span>🏷️</span> Code WAOUF10 (-10%)</li>
                        <li class="flex items-center gap-2"><span>🏥</span> Animaux identifiés & vaccinés</li>
                        <li class="flex items-center gap-2"><span>❤️</span> Zéro abandon, 100% amour</li>
                    </ul>
                </div>

                <!-- Navigation -->
                <div>
                    <h4 class="font-fredoka font-bold text-lg mb-4 text-ink flex items-center gap-2">
                        <span>🧭</span> Catégories
                    </h4>
                    <ul class="space-y-2 text-sm font-semibold">
                        <li><a href="{{ path('app_catalogue', {'categorie': 'animaux'}) }}" class="hover:underline flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-animaux border border-ink"></span> Animaux à adopter</a></li>
                        <li><a href="{{ path('app_catalogue', {'categorie': 'alimentation'}) }}" class="hover:underline flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-alimentation border border-ink"></span> Alimentation saine</a></li>
                        <li><a href="{{ path('app_catalogue', {'categorie': 'loisirs'}) }}" class="hover:underline flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-loisirs border border-ink"></span> Jouets & Loisirs</a></li>
                        <li><a href="{{ path('app_catalogue', {'categorie': 'fashion'}) }}" class="hover:underline flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-fashion border border-ink"></span> Fashion & Accessoires</a></li>
                    </ul>
                </div>

                <!-- Espace Membre -->
                <div>
                    <h4 class="font-fredoka font-bold text-lg mb-4 text-ink flex items-center gap-2">
                        <span>🐾</span> Espace Membre
                    </h4>
                    <div class="space-y-3">
                        {% if app.user %}
                            <p class="text-sm">Connecté en tant que <strong>{{ app.user.email }}</strong></p>
                            <a href="{{ path('app_account') }}" class="brutal-btn brutal-btn-white text-xs py-1.5 px-3 block text-center">
                                Mon Espace & Commandes
                            </a>
                        {% else %}
                            <p class="text-sm text-gray-700">Créez votre compte client pour suivre vos commandes et adoptions.</p>
                            <a href="{{ path('app_login') }}" class="brutal-btn brutal-btn-yellow text-xs py-2 px-3 block text-center">
                                Connexion / Inscription
                            </a>
                        {% endif %}
                    </div>
                </div>

            </div>

            <div class="border-t-[3px] border-ink pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-bold text-gray-600">
                <p>© {{ "now"|date("Y") }} WAOUF & CO ! — Fait avec amour, Symfony 8 et style Pop Néo-Brutaliste.</p>
                <div class="flex gap-4">
                    <span class="hover:underline cursor-pointer">Mentions Légales</span>
                    <span class="hover:underline cursor-pointer">Charte Vétérinaire</span>
                    <span class="hover:underline cursor-pointer">Conditions Générales</span>
                </div>
            </div>
        </div>
    </footer>

    <!-- Cart Drawer JavaScript (Vanilla AJAX / Turbo friendly) -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const drawer = document.getElementById('cart-drawer');
            const overlay = document.getElementById('cart-drawer-overlay');
            const openBtn = document.getElementById('open-cart-btn');
            const closeBtn = document.getElementById('close-cart-btn');
            const drawerContent = document.getElementById('cart-drawer-content');
            const badgeCount = document.getElementById('cart-badge-count');

            function openDrawer() {
                drawer.classList.add('open');
                overlay.classList.add('open');
                loadDrawerContent();
            }

            function closeDrawer() {
                drawer.classList.remove('open');
                overlay.classList.remove('open');
            }

            if (openBtn) openBtn.addEventListener('click', openDrawer);
            if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
            if (overlay) overlay.addEventListener('click', closeDrawer);

            async function loadDrawerContent() {
                try {
                    const res = await fetch("{{ path('app_panier_drawer') }}");
                    if (res.ok) {
                        const html = await res.text();
                        drawerContent.innerHTML = html;
                    }
                } catch (e) {
                    console.error("Erreur chargement panier:", e);
                }
            }

            // Expose globally for AJAX add-to-cart
            window.refreshCartUI = function(count, drawerHtml) {
                if (badgeCount && count !== undefined) {
                    badgeCount.textContent = count;
                }
                if (drawerHtml && drawerContent) {
                    drawerContent.innerHTML = drawerHtml;
                }
            };

            window.openCartDrawer = openDrawer;
        });
    </script>
</body>
</html>
