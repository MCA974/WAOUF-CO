{% extends 'base.html.twig' %}

{% block title %}Gestion des Commandes - Admin WAOUF & CO !{% endblock %}

{% block body %}
    <div class="space-y-6">
        
        <div class="flex items-center justify-between border-b-[3px] border-ink pb-4">
            <div>
                <a href="{{ path('app_admin_dashboard') }}" class="text-xs font-bold text-gray-500 hover:underline">← Retour Dashboard</a>
                <h1 class="font-fredoka text-3xl font-extrabold text-ink">Gestion des Commandes & Adoptions</h1>
            </div>
            <span class="text-sm font-bold text-gray-500 font-fredoka">
                {{ commandes|length }} commande{% if commandes|length > 1 %}s{% endif %}
            </span>
        </div>

        {% if commandes|length == 0 %}
            <div class="brutal-card bg-card p-10 text-center space-y-3">
                <p class="font-fredoka text-lg font-bold text-gray-700">Aucune commande pour le moment.</p>
            </div>
        {% else %}
            <div class="space-y-4">
                {% for cmd in commandes %}
                    <div class="brutal-card bg-card p-6 border-[3px] border-ink space-y-4">
                        
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b-2 border-gray-100 pb-3">
                            <div>
                                <div class="flex items-center gap-2">
                                    <h3 class="font-fredoka text-xl font-bold text-ink">{{ cmd.reference }}</h3>
                                    <span class="text-xs font-semibold text-gray-500">• {{ cmd.dateCreation|date('d/m/Y à H:i') }}</span>
                                    {% if cmd.aUneAdoption %}
                                        <span class="brutal-badge bg-animaux text-white text-[10px]">
                                            🐾 Contient une adoption
                                        </span>
                                    {% endif %}
                                </div>
                                <p class="text-xs text-gray-600 mt-1">
                                    Client : <strong>{{ cmd.utilisateur ? cmd.utilisateur.prenom ~ ' ' ~ cmd.utilisateur.nom ~ ' (' ~ cmd.utilisateur.email ~ ')' : 'Client invité' }}</strong>
                                </p>
                            </div>

                            <!-- Status Change Form -->
                            <form action="{{ path('app_admin_commande_statut', {'id': cmd.id}) }}" method="POST" class="flex items-center gap-2">
                                <label for="statut-{{ cmd.id }}" class="text-xs font-bold font-fredoka uppercase text-gray-600">Statut :</label>
                                <select 
                                    id="statut-{{ cmd.id }}" 
                                    name="statut" 
                                    class="brutal-input text-xs font-bold py-1.5 px-3 bg-card cursor-pointer"
                                >
                                    <option value="EN_ATTENTE" {% if cmd.statut == 'EN_ATTENTE' %}selected{% endif %}>EN_ATTENTE</option>
                                    <option value="PAYEE" {% if cmd.statut == 'PAYEE' %}selected{% endif %}>PAYEE</option>
                                    <option value="VALIDATION_ADOPTION" {% if cmd.statut == 'VALIDATION_ADOPTION' %}selected{% endif %}>VALIDATION_ADOPTION</option>
                                    <option value="EXPEDIEE" {% if cmd.statut == 'EXPEDIEE' %}selected{% endif %}>EXPEDIEE</option>
                                </select>
                                <button type="submit" class="brutal-btn brutal-btn-yellow py-1.5 px-3 text-xs font-bold">
                                    Mettre à jour
                                </button>
                            </form>
                        </div>

                        <!-- Lines -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 text-xs">
                            {% for ligne in cmd.lignes %}
                                <div class="bg-gray-50 border border-ink rounded-lg p-2.5 flex items-center justify-between">
                                    <div class="truncate">
                                        <strong>{{ ligne.quantite }}x</strong> {{ ligne.article.nom }}
                                        {% if ligne.optionChoisie %}<span class="text-gray-500">({{ ligne.optionChoisie }})</span>{% endif %}
                                        {% if ligne.article.animal %}<span class="text-animaux font-bold">🐾 (Animal)</span>{% endif %}
                                    </div>
                                    <span class="font-bold ml-2 whitespace-nowrap">{{ ligne.totalEnEuros|number_format(2, ',', ' ') }} €</span>
                                </div>
                            {% endfor %}
                        </div>

                        <div class="border-t border-gray-200 pt-3 flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs">
                            <div class="text-gray-600">
                                <strong>Adresse de livraison :</strong> {{ cmd.adresseLivraison }}
                            </div>
                            <div class="font-fredoka text-base font-bold text-ink">
                                Total : <span class="text-animaux">{{ cmd.montantTotalEnEuros|number_format(2, ',', ' ') }} €</span>
                            </div>
                        </div>

                    </div>
                {% endfor %}
            </div>
        {% endif %}

    </div>
{% endblock %}
