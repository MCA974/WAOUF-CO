{% extends 'base.html.twig' %}

{% block title %}Gestion des Catégories - Admin WAOUF & CO !{% endblock %}

{% block body %}
    <div class="space-y-6">
        
        <div class="flex items-center justify-between border-b-[3px] border-ink pb-4">
            <div>
                <a href="{{ path('app_admin_dashboard') }}" class="text-xs font-bold text-gray-500 hover:underline">← Retour Dashboard</a>
                <h1 class="font-fredoka text-3xl font-extrabold text-ink">Gestion des Catégories Pop</h1>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            
            <!-- List of categories -->
            <div class="lg:col-span-7 space-y-4">
                <div class="brutal-card bg-card border-[3px] border-ink overflow-hidden">
                    <table class="w-full text-left border-collapse text-sm">
                        <thead>
                            <tr class="bg-gray-100 border-b-2 border-ink font-fredoka font-bold text-xs uppercase text-gray-700">
                                <th class="p-3.5">Couleur</th>
                                <th class="p-3.5">Nom</th>
                                <th class="p-3.5">Slug URL</th>
                                <th class="p-3.5">Articles</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y border-ink">
                            {% for cat in categories %}
                                <tr class="hover:bg-yellow-50/50">
                                    <td class="p-3.5">
                                        <div class="flex items-center gap-2">
                                            <span class="w-6 h-6 rounded-full border-2 border-ink inline-block" style="background-color: {{ cat.couleurHex }};"></span>
                                            <code class="text-xs font-mono font-bold">{{ cat.couleurHex }}</code>
                                        </div>
                                    </td>
                                    <td class="p-3.5 font-fredoka font-bold text-base text-ink">
                                        {{ cat.nom }}
                                    </td>
                                    <td class="p-3.5 text-xs text-gray-600 font-mono">
                                        /{{ cat.urlSimplifiee }}
                                    </td>
                                    <td class="p-3.5">
                                        <span class="brutal-badge bg-gray-100 text-xs">
                                            {{ cat.articles|length }} article{% if cat.articles|length > 1 %}s{% endif %}
                                        </span>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- New category form -->
            <div class="lg:col-span-5">
                <form method="POST" class="brutal-card bg-card p-6 border-[3px] border-ink space-y-4">
                    <h3 class="font-fredoka text-xl font-bold border-b-2 border-ink pb-2 flex items-center gap-2">
                        <span>➕</span> Nouvelle Catégorie
                    </h3>

                    <div>
                        <label for="nom" class="block font-fredoka font-bold text-xs uppercase text-gray-700 mb-1">Nom de la catégorie *</label>
                        <input type="text" id="nom" name="nom" required placeholder="ex: Soins & Beauté" class="brutal-input text-sm">
                    </div>

                    <div>
                        <label for="couleurHex" class="block font-fredoka font-bold text-xs uppercase text-gray-700 mb-1">Couleur Pop Hexadécimale *</label>
                        <div class="flex items-center gap-3">
                            <input type="color" id="couleurHex" name="couleurHex" value="#FF6B6B" class="w-12 h-10 border-2 border-ink rounded cursor-pointer p-0">
                            <span class="text-xs text-gray-600 font-medium">Palette officielle : #FF6B6B, #4ECDC4, #FFE66D, #A29BFE</span>
                        </div>
                    </div>

                    <button type="submit" class="brutal-btn brutal-btn-yellow w-full py-3 text-sm font-bold shadow-brutal-hover">
                        Créer la Catégorie
                    </button>
                </form>
            </div>

        </div>

    </div>
{% endblock %}
