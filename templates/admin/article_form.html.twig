{% extends 'base.html.twig' %}

{% block title %}{{ article ? 'Modifier Article' : 'Nouvel Article' }} - Admin WAOUF & CO !{% endblock %}

{% block body %}
    <div class="max-w-3xl mx-auto space-y-6">
        
        <div class="flex items-center justify-between border-b-[3px] border-ink pb-4">
            <div>
                <a href="{{ path('app_admin_articles') }}" class="text-xs font-bold text-gray-500 hover:underline">← Retour à la liste</a>
                <h1 class="font-fredoka text-3xl font-extrabold text-ink">
                    {{ article ? 'Modifier : ' ~ article.nom : 'Créer un Nouvel Article / Animal' }}
                </h1>
            </div>
        </div>

        <form method="POST" class="brutal-card bg-card p-6 sm:p-8 border-[3px] border-ink space-y-6">
            
            <!-- Standard Article Fields -->
            <div class="space-y-4">
                <h3 class="font-fredoka text-xl font-bold border-b-2 border-ink pb-2 flex items-center gap-2">
                    <span>📦</span> Informations Générales
                </h3>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label for="nom" class="block font-fredoka font-bold text-xs uppercase text-gray-700 mb-1">Nom de l'article *</label>
                        <input type="text" id="nom" name="nom" value="{{ article ? article.nom : '' }}" required class="brutal-input text-sm">
                    </div>

                    <div>
                        <label for="categorie_id" class="block font-fredoka font-bold text-xs uppercase text-gray-700 mb-1">Catégorie *</label>
                        <select id="categorie_id" name="categorie_id" required class="brutal-input text-sm cursor-pointer">
                            {% for cat in categories %}
                                <option value="{{ cat.id }}" {% if article and article.categorie.id == cat.id %}selected{% endif %}>
                                    {{ cat.nom }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <div>
                        <label for="prix" class="block font-fredoka font-bold text-xs uppercase text-gray-700 mb-1">Prix (en Euros €) *</label>
                        <input type="number" step="0.01" min="0" id="prix" name="prix" value="{{ article ? article.prixEnEuros : '19.90' }}" required class="brutal-input text-sm">
                    </div>

                    <div>
                        <label for="stock" class="block font-fredoka font-bold text-xs uppercase text-gray-700 mb-1">Stock disponible *</label>
                        <input type="number" min="0" id="stock" name="stock" value="{{ article ? article.stock : '25' }}" required class="brutal-input text-sm">
                    </div>

                    <div>
                        <label for="badge" class="block font-fredoka font-bold text-xs uppercase text-gray-700 mb-1">Badge Sticker (Optionnel)</label>
                        <input type="text" id="badge" name="badge" value="{{ article ? article.badge : '' }}" placeholder="ex: NOUVEAU, BIO, TOP" class="brutal-input text-sm">
                    </div>
                </div>

                <div>
                    <label for="image" class="block font-fredoka font-bold text-xs uppercase text-gray-700 mb-1">URL de l'image *</label>
                    <input type="url" id="image" name="image" value="{{ article ? article.image : 'https://images.unsplash.com/photo-1548199973-03cce0bbc87b?auto=format&fit=crop&w=800&q=80' }}" required class="brutal-input text-sm">
                </div>

                <div>
                    <label for="description" class="block font-fredoka font-bold text-xs uppercase text-gray-700 mb-1">Description détaillée *</label>
                    <textarea id="description" name="description" rows="3" required class="brutal-input text-sm">{{ article ? article.description : '' }}</textarea>
                </div>

                <div>
                    <label for="options" class="block font-fredoka font-bold text-xs uppercase text-gray-700 mb-1">
                        Options / Tailles (séparées par des virgules, ex: S, M, L)
                    </label>
                    <input type="text" id="options" name="options" value="{{ article and article.options ? article.options|join(', ') : '' }}" placeholder="S, M, L ou Taille 1, Taille 2" class="brutal-input text-sm">
                </div>

                {% if article %}
                    <div class="flex items-center gap-2 pt-2">
                        <input type="checkbox" id="disponible" name="disponible" value="1" {% if article.disponible %}checked{% endif %} class="w-4 h-4 text-animaux rounded border-2 border-ink">
                        <label for="disponible" class="text-sm font-bold font-fredoka text-ink">Article actif et visible dans le catalogue</label>
                    </div>
                {% endif %}
            </div>

            <!-- Animal Fields (If creating with animal checkbox or editing an animal) -->
            {% set hasAnimal = (article and article.animal) %}
            <div class="border-t-[3px] border-ink pt-6 space-y-4">
                
                <div class="flex items-center justify-between">
                    <h3 class="font-fredoka text-xl font-bold flex items-center gap-2">
                        <span>🩺</span> Fiche Carnet de Santé Animalier
                    </h3>
                    {% if not article %}
                        <label class="flex items-center gap-2 text-xs font-bold font-fredoka cursor-pointer bg-red-100 border border-animaux px-2.5 py-1 rounded-lg">
                            <input type="checkbox" name="is_animal" id="toggle-animal" value="1" onchange="document.getElementById('animal-fields').classList.toggle('hidden', !this.checked)">
                            <span>Cocher s'il s'agit d'un animal vivant</span>
                        </label>
                    {% endif %}
                </div>

                <div id="animal-fields" class="space-y-4 {% if not hasAnimal %}hidden{% endif %} bg-red-50/70 border-2 border-animaux p-4 rounded-xl">
                    {% set animal = article ? article.animal : null %}

                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                        <div>
                            <label for="espece" class="block font-fredoka font-bold text-xs uppercase text-gray-700 mb-1">Espèce *</label>
                            <select id="espece" name="espece" class="brutal-input text-xs cursor-pointer">
                                <option value="Chien" {% if animal and animal.espece == 'Chien' %}selected{% endif %}>Chien</option>
                                <option value="Chat" {% if animal and animal.espece == 'Chat' %}selected{% endif %}>Chat</option>
                                <option value="Lapin" {% if animal and animal.espece == 'Lapin' %}selected{% endif %}>Lapin</option>
                                <option value="Oiseau" {% if animal and animal.espece == 'Oiseau' %}selected{% endif %}>Oiseau</option>
                            </select>
                        </div>

                        <div>
                            <label for="race" class="block font-fredoka font-bold text-xs uppercase text-gray-700 mb-1">Race *</label>
                            <input type="text" id="race" name="race" value="{{ animal ? animal.race : '' }}" placeholder="ex: Golden Retriever" class="brutal-input text-xs">
                        </div>

                        <div>
                            <label for="sexe" class="block font-fredoka font-bold text-xs uppercase text-gray-700 mb-1">Sexe *</label>
                            <select id="sexe" name="sexe" class="brutal-input text-xs cursor-pointer">
                                <option value="Mâle" {% if animal and animal.sexe == 'Mâle' %}selected{% endif %}>Mâle</option>
                                <option value="Femelle" {% if animal and animal.sexe == 'Femelle' %}selected{% endif %}>Femelle</option>
                            </select>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div>
                            <label for="date_naissance" class="block font-fredoka font-bold text-xs uppercase text-gray-700 mb-1">Date de Naissance *</label>
                            <input type="date" id="date_naissance" name="date_naissance" value="{{ animal and animal.dateNaissance ? animal.dateNaissance|date('Y-m-d') : '2024-01-01' }}" class="brutal-input text-xs">
                        </div>

                        <div>
                            <label for="numero_puce" class="block font-fredoka font-bold text-xs uppercase text-gray-700 mb-1">Numéro de Puce I-CAD (15 chiffres) *</label>
                            <input type="text" id="numero_puce" name="numero_puce" value="{{ animal ? animal.numeroPuce : '' }}" placeholder="250269608991234" class="brutal-input text-xs font-mono">
                        </div>
                    </div>

                    <div class="flex flex-wrap gap-4 pt-1">
                        <label class="flex items-center gap-2 text-xs font-bold font-fredoka cursor-pointer">
                            <input type="checkbox" name="vaccine" value="1" {% if not animal or animal.vaccine %}checked{% endif %} class="w-4 h-4 text-animaux rounded">
                            <span>Vaccins à jour (CHPPi, Rage...) ✅</span>
                        </label>
                        <label class="flex items-center gap-2 text-xs font-bold font-fredoka cursor-pointer">
                            <input type="checkbox" name="sterilise" value="1" {% if not animal or animal.sterilise %}checked{% endif %} class="w-4 h-4 text-animaux rounded">
                            <span>Stérilisé(e) / Castré(e) ✅</span>
                        </label>
                    </div>
                </div>

            </div>

            <!-- Submit buttons -->
            <div class="pt-4 flex items-center justify-end gap-3 border-t-[3px] border-ink">
                <a href="{{ path('app_admin_articles') }}" class="brutal-btn brutal-btn-white py-2 px-4 text-sm">
                    Annuler
                </a>
                <button type="submit" class="brutal-btn brutal-btn-primary py-2.5 px-6 text-sm font-bold shadow-brutal-hover">
                    💾 Enregistrer l'article
                </button>
            </div>

        </form>

    </div>
{% endblock %}
