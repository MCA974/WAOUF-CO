{% extends 'base.html.twig' %}

{% block title %}Dashboard Admin - WAOUF & CO !{% endblock %}

{% block body %}
    <div class="space-y-8">
        
        <!-- Header -->
        <div class="brutal-card bg-loisirs p-6 sm:p-8 border-[3px] border-ink flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div>
                <span class="brutal-sticker bg-animaux text-white rotate-left text-xs mb-1">
                    ⚡ ACCÈS PRIVILÉGIÉ ROLE_ADMIN
                </span>
                <h1 class="font-fredoka text-3xl font-extrabold text-ink">
                    Tableau de Bord Administrateur
                </h1>
                <p class="text-xs font-semibold text-gray-800">
                    Gérez les stocks, ajoutez des articles et validez les adoptions d'animaux.
                </p>
            </div>

            <div class="flex flex-wrap gap-2">
                <a href="{{ path('app_admin_article_new') }}" class="brutal-btn brutal-btn-primary text-xs py-2 px-3.5">
                    ➕ Nouvel Article / Animal
                </a>
                <a href="{{ path('app_admin_categories') }}" class="brutal-btn brutal-btn-white text-xs py-2 px-3">
                    🏷️ Catégories
                </a>
                <a href="{{ path('app_admin_commandes') }}" class="brutal-btn brutal-btn-mint text-xs py-2 px-3">
                    📦 Commandes
                </a>
            </div>
        </div>

        <!-- KPI Metrics -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
            <div class="brutal-card bg-card p-5 border-[3px] border-ink">
                <div class="text-2xl mb-1">📦</div>
                <span class="text-xs font-bold text-gray-500 uppercase font-fredoka block">Articles en vente</span>
                <span class="font-fredoka text-3xl font-extrabold text-ink">{{ totalArticles }}</span>
            </div>

            <div class="brutal-card bg-card p-5 border-[3px] border-ink">
                <div class="text-2xl mb-1">🐾</div>
                <span class="text-xs font-bold text-gray-500 uppercase font-fredoka block">Animaux protégés</span>
                <span class="font-fredoka text-3xl font-extrabold text-animaux">{{ totalAnimaux }}</span>
            </div>

            <div class="brutal-card bg-card p-5 border-[3px] border-ink">
                <div class="text-2xl mb-1">🛒</div>
                <span class="text-xs font-bold text-gray-500 uppercase font-fredoka block">Commandes passées</span>
                <span class="font-fredoka text-3xl font-extrabold text-ink">{{ totalCommandes }}</span>
            </div>

            <div class="brutal-card bg-card p-5 border-[3px] border-ink">
                <div class="text-2xl mb-1">💰</div>
                <span class="text-xs font-bold text-gray-500 uppercase font-fredoka block">Chiffre d'Affaires</span>
                <span class="font-fredoka text-2xl font-extrabold text-green-700">
                    {{ (totalVentes / 100)|number_format(2, ',', ' ') }} €
                </span>
            </div>
        </div>

        <!-- Recent Articles & Recent Orders -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            
            <!-- Articles -->
            <div class="brutal-card bg-card p-6 border-[3px] border-ink space-y-4">
                <div class="flex items-center justify-between border-b-2 border-ink pb-3">
                    <h3 class="font-fredoka text-xl font-bold flex items-center gap-2">
                        <span>🏷️</span> Derniers Articles
                    </h3>
                    <a href="{{ path('app_admin_articles') }}" class="text-xs font-bold text-animaux hover:underline">
                        Tout voir ➔
                    </a>
                </div>

                <div class="space-y-3">
                    {% for art in articles %}
                        <div class="flex items-center justify-between p-2 rounded-lg bg-gray-50 border border-ink text-sm">
                            <div class="flex items-center gap-2 truncate">
                                <img src="{{ art.image }}" alt="" class="w-10 h-10 rounded border border-ink object-cover flex-shrink-0">
                                <div class="truncate">
                                    <strong class="font-fredoka block truncate text-ink">{{ art.nom }}</strong>
                                    <span class="text-xs text-gray-500">{{ art.categorie.nom }} • Stock: {{ art.stock }}</span>
                                </div>
                            </div>
                            <div class="flex items-center gap-2 flex-shrink-0">
                                <span class="font-bold font-fredoka text-xs">{{ art.prix|prix_euro }}</span>
                                <a href="{{ path('app_admin_article_edit', {'id': art.id}) }}" class="brutal-btn brutal-btn-white py-1 px-2 text-xs">
                                    ✏️
                                </a>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>

            <!-- Orders -->
            <div class="brutal-card bg-card p-6 border-[3px] border-ink space-y-4">
                <div class="flex items-center justify-between border-b-2 border-ink pb-3">
                    <h3 class="font-fredoka text-xl font-bold flex items-center gap-2">
                        <span>📦</span> Dernières Commandes
                    </h3>
                    <a href="{{ path('app_admin_commandes') }}" class="text-xs font-bold text-animaux hover:underline">
                        Tout gérer ➔
                    </a>
                </div>

                <div class="space-y-3">
                    {% if commandes|length == 0 %}
                        <p class="text-sm text-gray-500 font-semibold py-4 text-center">Aucune commande pour le moment.</p>
                    {% else %}
                        {% for cmd in commandes %}
                            <div class="flex items-center justify-between p-2.5 rounded-lg bg-gray-50 border border-ink text-sm">
                                <div>
                                    <strong class="font-fredoka block text-ink">{{ cmd.reference }}</strong>
                                    <span class="text-xs text-gray-500">{{ cmd.dateCreation|date('d/m H:i') }}</span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <span class="brutal-badge text-[10px] {% if cmd.statut == 'VALIDATION_ADOPTION' %}bg-animaux text-white{% else %}bg-green-100 text-green-800{% endif %}">
                                        {{ cmd.statut }}
                                    </span>
                                    <span class="font-bold text-xs font-fredoka">{{ cmd.montantTotalEnEuros|number_format(2, ',', ' ') }} €</span>
                                </div>
                            </div>
                        {% endfor %}
                    {% endif %}
                </div>
            </div>

        </div>

    </div>
{% endblock %}
