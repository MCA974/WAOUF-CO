{% extends 'base.html.twig' %}

{% block title %}Connexion - WAOUF & CO !{% endblock %}

{% block body %}
    <div class="max-w-md mx-auto space-y-6">
        
        <div class="text-center space-y-2">
            <div class="w-16 h-16 bg-loisirs border-[3px] border-ink rounded-2xl shadow-brutal mx-auto flex items-center justify-center text-3xl">
                🔑
            </div>
            <h1 class="font-fredoka text-3xl font-extrabold text-ink">Espace Membre</h1>
            <p class="text-sm font-semibold text-gray-600">Connectez-vous pour retrouver vos commandes et adoptions.</p>
        </div>

        <div class="brutal-card bg-card p-6 sm:p-8 border-[3px] border-ink space-y-5">
            {% if error %}
                <div class="bg-red-100 border-2 border-animaux text-animaux p-3 rounded-lg text-xs font-bold font-fredoka">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            <form method="POST" action="{{ path('app_login') }}" class="space-y-4">
                <div>
                    <label for="inputEmail" class="block font-fredoka font-bold text-xs uppercase text-gray-700 mb-1">
                        Adresse Email
                    </label>
                    <input 
                        type="email" 
                        value="{{ last_username }}" 
                        name="email" 
                        id="inputEmail" 
                        class="brutal-input text-sm" 
                        autocomplete="email" 
                        required 
                        autofocus
                        placeholder="camille@waouf.fr"
                    >
                </div>

                <div>
                    <label for="inputPassword" class="block font-fredoka font-bold text-xs uppercase text-gray-700 mb-1">
                        Mot de passe
                    </label>
                    <input 
                        type="password" 
                        name="password" 
                        id="inputPassword" 
                        class="brutal-input text-sm" 
                        autocomplete="current-password" 
                        required
                        placeholder="••••••••"
                    >
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button type="submit" class="brutal-btn brutal-btn-primary w-full py-3.5 text-base font-bold shadow-brutal-hover">
                    Se connecter ➔
                </button>
            </form>

            <div class="border-t-2 border-dashed border-gray-200 pt-4 text-center">
                <p class="text-xs font-semibold text-gray-600">Pas encore de compte chez nous ?</p>
                <a href="{{ path('app_register') }}" class="font-fredoka font-bold text-sm text-animaux hover:underline mt-1 inline-block">
                    Créer un compte en 30 secondes 🐾
                </a>
            </div>
        </div>

        <!-- Quick Credentials Helper for Evaluation -->
        <div class="brutal-card bg-gray-50 p-4 border-2 border-ink text-xs space-y-2">
            <span class="font-fredoka font-bold uppercase text-gray-700 block">💡 Comptes de test pré-configurés :</span>
            <div class="flex flex-col gap-1 text-gray-600 font-medium">
                <div><strong>Admin :</strong> admin@waouf.fr / <code>Admin123!</code></div>
                <div><strong>Client :</strong> camille@waouf.fr / <code>Client123!</code></div>
            </div>
        </div>

    </div>
{% endblock %}
