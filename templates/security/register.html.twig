{% extends 'base.html.twig' %}

{% block title %}Créer un compte - WAOUF & CO !{% endblock %}

{% block body %}
    <div class="max-w-md mx-auto space-y-6">
        
        <div class="text-center space-y-2">
            <div class="w-16 h-16 bg-alimentation border-[3px] border-ink rounded-2xl shadow-brutal mx-auto flex items-center justify-center text-3xl">
                🐾
            </div>
            <h1 class="font-fredoka text-3xl font-extrabold text-ink">Rejoignez la Meute !</h1>
            <p class="text-sm font-semibold text-gray-600">Créez votre profil pour commander et adopter facilement.</p>
        </div>

        <div class="brutal-card bg-card p-6 sm:p-8 border-[3px] border-ink space-y-5">
            <form method="POST" action="{{ path('app_register') }}" class="space-y-4">
                
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label for="prenom" class="block font-fredoka font-bold text-xs uppercase text-gray-700 mb-1">Prénom *</label>
                        <input type="text" name="prenom" id="prenom" required class="brutal-input text-sm" placeholder="Camille">
                    </div>
                    <div>
                        <label for="nom" class="block font-fredoka font-bold text-xs uppercase text-gray-700 mb-1">Nom *</label>
                        <input type="text" name="nom" id="nom" required class="brutal-input text-sm" placeholder="Dupont">
                    </div>
                </div>

                <div>
                    <label for="email" class="block font-fredoka font-bold text-xs uppercase text-gray-700 mb-1">Adresse Email *</label>
                    <input type="email" name="email" id="email" required class="brutal-input text-sm" placeholder="camille@exemple.fr">
                </div>

                <div>
                    <label for="password" class="block font-fredoka font-bold text-xs uppercase text-gray-700 mb-1">Mot de passe *</label>
                    <input type="password" name="password" id="password" required class="brutal-input text-sm" placeholder="••••••••">
                </div>

                <div>
                    <label for="telephone" class="block font-fredoka font-bold text-xs uppercase text-gray-700 mb-1">Téléphone</label>
                    <input type="tel" name="telephone" id="telephone" class="brutal-input text-sm" placeholder="06 12 34 56 78">
                </div>

                <div>
                    <label for="adresse" class="block font-fredoka font-bold text-xs uppercase text-gray-700 mb-1">Adresse postale</label>
                    <textarea name="adresse" id="adresse" rows="2" class="brutal-input text-sm" placeholder="10 rue de la Joie, 75000 Paris"></textarea>
                </div>

                <button type="submit" class="brutal-btn brutal-btn-mint w-full py-3.5 text-base font-bold shadow-brutal-hover">
                    Créer mon compte ➔
                </button>
            </form>

            <div class="border-t-2 border-dashed border-gray-200 pt-4 text-center">
                <p class="text-xs font-semibold text-gray-600">Vous avez déjà un compte ?</p>
                <a href="{{ path('app_login') }}" class="font-fredoka font-bold text-sm text-animaux hover:underline mt-1 inline-block">
                    Se connecter ici 🔑
                </a>
            </div>
        </div>

    </div>
{% endblock %}
